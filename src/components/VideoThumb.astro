---
// A typographic video tile: no third-party thumbnails are loaded, so nothing
// is fetched from YouTube until a visitor chooses to play a video.
interface Props {
  label: string;
  duration?: string | null;
  published?: boolean;
}

const { label, duration, published = false } = Astro.props;
---

<span class="vthumb" aria-hidden="true">
  <span class="vlabel">{label}</span>
  <span class="play">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
      <polygon points="8 5 19 12 8 19 8 5"></polygon>
    </svg>
  </span>
  <span class="vmeta">{published ? (duration ?? "") : "Coming soon"}</span>
</span>

<style>
  .vthumb {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    aspect-ratio: 16 / 9;
    padding: 0.8rem 0.95rem;
    background: var(--color-primary);
    color: var(--color-on-dark);
    border-bottom: 3px solid var(--color-accent);
  }

  .vlabel,
  .vmeta {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-on-dark-muted);
  }

  .vmeta {
    align-self: flex-end;
  }

  .play {
    position: absolute;
    inset: 50% auto auto 50%;
    translate: -50% -50%;
    width: 3.2rem;
    height: 3.2rem;
    border-radius: 50%;
    border: 1.5px solid var(--color-on-dark);
    display: grid;
    place-items: center;
    padding-left: 0.2rem;
  }
</style>
