---
// "Field Journal" layout – used for Field Notes (stories from experience).
import type { CollectionEntry } from "astro:content";
import AuthorBox from "./AuthorBox.astro";
import VideoCard from "./VideoCard.astro";
import { THEMES, TOPICS } from "../lib/taxonomy";
import { articleUrl, formatDate, readingMinutes } from "../lib/content";

interface Props {
  article: CollectionEntry<"articles">;
  entryNumber?: number;
  Content: any;
  video?: CollectionEntry<"videos">;
  previous?: CollectionEntry<"articles">;
  next?: CollectionEntry<"articles">;
}

const { article, entryNumber, Content, video, previous, next } = Astro.props;
const { data } = article;
const topicLabels = data.topics.map((t) => TOPICS[t]);
// Optional sections show only when the writer has actually filled them in.
const filled = (text?: string | null) =>
  typeof text === "string" && text.trim().length > 0;
const card = data.storyCard;
const showCard =
  !!card &&
  filled(card.context) &&
  filled(card.happened) &&
  filled(card.learned);
const showQuestion = filled(data.question);
---

<article class="journal">
  <header class="container head">
    <div class="title-block">
      <p class="kicker">
        Field Notes
        {entryNumber && (
          <>
            <span class="sep">/</span>
            <span class="entry">
              Entry No. {String(entryNumber).padStart(2, "0")}
            </span>
          </>
        )}
        {data.draft && <span class="example-badge">Example</span>}
      </p>
      <h1>{data.title}</h1>
      <p class="standfirst">{data.summary}</p>
    </div>
    <dl class="facts">
      <div>
        <dt>Published</dt>
        <dd>{formatDate(data.date)}</dd>
      </div>
      <div>
        <dt>Reading time</dt>
        <dd>
          {readingMinutes(article.body)}{" "}
          {readingMinutes(article.body) === 1 ? "minute" : "minutes"}
        </dd>
      </div>
      {topicLabels.length > 0 && (
        <div>
          <dt>Topics</dt>
          <dd>{topicLabels.join(", ")}</dd>
        </div>
      )}
      {data.themes.length > 0 && (
        <div>
          <dt>Themes</dt>
          <dd>{data.themes.map((t) => THEMES[t]).join(", ")}</dd>
        </div>
      )}
    </dl>
  </header>

  {showCard && card && (
    <section class="container" aria-label="The story in brief">
      <div class="story-card">
        <div>
          <p class="label">The context</p>
          <p>{card.context}</p>
        </div>
        <div>
          <p class="label">What happened</p>
          <p>{card.happened}</p>
        </div>
        <div class="learned">
          <p class="label">What I learned</p>
          <p>{card.learned}</p>
        </div>
      </div>
    </section>
  )}

  <div class="body-wrap">
    <div class="prose numbered">
      <Content />
    </div>

    {data.takeaways.length > 0 && (
      <section class="takeaways" aria-label="Key takeaways">
        <p class="label">Key takeaways</p>
        <ol>
          {data.takeaways.map((t) => (
            <li>{t}</li>
          ))}
        </ol>
      </section>
    )}

    {showQuestion && (
      <section class="question" aria-label="A question for you">
        <p class="label">A question for you</p>
        <p class="q">{data.question}</p>
      </section>
    )}

    {video && <VideoCard video={video} />}

    <AuthorBox signed />
  </div>

  {(previous || next) && (
    <nav class="container entries" aria-label="More field notes">
      {previous ? (
        <a href={articleUrl(previous)} class="prev">
          <span class="label">← Previous entry</span>
          <span class="t">{previous.data.title}</span>
        </a>
      ) : (
        <span />
      )}
      {next && (
        <a href={articleUrl(next)} class="next">
          <span class="label">Next entry →</span>
          <span class="t">{next.data.title}</span>
        </a>
      )}
    </nav>
  )}
</article>

<style>
  .head {
    display: grid;
    grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: end;
    padding-block: clamp(2.5rem, 6vw, 4.5rem) 2rem;
  }

  .title-block {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .sep {
    color: var(--color-line-strong);
    margin-inline: 0.35rem;
  }

  .entry {
    color: var(--color-muted);
  }

  h1 {
    font-size: clamp(2.2rem, 5vw, 3.5rem);
    line-height: 1.07;
  }

  .standfirst {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 1.35rem;
    line-height: 1.5;
    color: var(--color-muted);
  }

  .facts {
    margin: 0;
    border-left: 1px solid var(--color-line);
    padding-left: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-size: 0.9rem;
    color: var(--color-muted);
  }

  .facts div {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .facts dt {
    font-weight: 600;
    color: var(--color-fg);
  }

  .facts dd {
    margin: 0;
  }

  .label {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-teal);
    margin-bottom: 0.5rem;
  }

  .story-card {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    background: var(--color-surface);
    border: 1px solid var(--color-line);
  }

  .story-card > div {
    padding: 1.5rem 1.75rem;
    font-family: var(--font-heading);
    font-size: 1.12rem;
    line-height: 1.5;
  }

  .story-card > div + div {
    border-left: 1px solid var(--color-line);
  }

  .story-card .learned {
    background: var(--color-primary);
    color: var(--color-on-dark);
  }

  .story-card .learned .label {
    color: var(--color-accent);
  }

  .body-wrap {
    width: min(var(--reading-width), 100% - 2.5rem);
    margin: 0 auto;
    padding-top: clamp(2.5rem, 5vw, 3.5rem);
  }

  /* Numbered section headings: 01, 02, 03 … */
  .numbered {
    counter-reset: section;
  }

  .numbered :global(h2) {
    counter-increment: section;
    display: flex;
    align-items: baseline;
    gap: 1rem;
  }

  .numbered :global(h2)::before {
    content: counter(section, decimal-leading-zero);
    color: var(--color-accent);
    font-size: 2.2rem;
  }

  .takeaways,
  .question {
    margin-top: 2.5rem;
    padding: 1.6rem 1.8rem;
  }

  .takeaways {
    background: var(--color-surface);
    border: 2px dashed var(--color-line-strong);
  }

  .takeaways ol {
    margin: 0;
    padding-left: 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .question {
    background: var(--color-sand);
  }

  .question .label {
    color: var(--color-primary);
  }

  .q {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 1.45rem;
    line-height: 1.4;
    color: var(--color-primary);
  }

  .entries {
    margin-top: 3.5rem;
    border-top: 1px solid var(--color-line);
    padding-top: 1.75rem;
    display: flex;
    justify-content: space-between;
    gap: 2rem;
  }

  .entries a {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    text-decoration: none;
    max-width: 26rem;
  }

  .entries .next {
    text-align: right;
    margin-left: auto;
  }

  .entries .label {
    color: var(--color-muted);
    margin: 0;
  }

  .entries .t {
    font-family: var(--font-heading);
    font-size: 1.3rem;
    color: var(--color-primary);
  }

  @media (max-width: 860px) {
    .head,
    .story-card {
      grid-template-columns: minmax(0, 1fr);
    }
    .facts {
      border-left: 0;
      padding-left: 0;
    }
    .story-card > div + div {
      border-left: 0;
      border-top: 1px solid var(--color-line);
    }
  }
</style>
