---
// A photo inside an article, full reading width, with an optional caption.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  image: ImageMetadata;
  alt: string;
  caption?: string;
}

const { image, alt, caption } = Astro.props;
---

<figure class="photo">
  <Image
    src={image}
    alt={alt}
    widths={[480, 960, 1440]}
    sizes="(max-width: 760px) 100vw, 720px"
  />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .photo {
    margin: 2rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .photo :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-bottom: 4px solid var(--color-accent);
  }

  figcaption {
    font-family: var(--font-body);
    font-size: 0.88rem;
    line-height: 1.45;
    color: var(--color-muted);
  }
</style>
