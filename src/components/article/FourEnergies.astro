---
// Four kinds of energy in a team, as simple emblems: a spark plug, a race
// horse, a zombie (a flat battery) and a vampire (a bat).
interface Props {
  caption?: string;
}
const { caption } = Astro.props;

const tiles = [
  {
    x: 10,
    name: "Spark plugs",
    tag: "Create energy",
    bg: "#0f5257",
    fg: "#f6f1ea",
    icon: `<rect x="70" y="60" width="24" height="18" fill="#f6f1ea"/>
      <path d="M62 78 L102 78 L102 100 L62 100 Z" fill="#c9dedc"/>
      <path d="M66 100 L98 100 L94 140 L70 140 Z" fill="#f6f1ea"/>
      <rect x="78" y="140" width="8" height="18" fill="#c9dedc"/>
      <path d="M110 120 L128 100 L120 118 L136 112 L116 140 L122 122 Z" fill="#e07a4f"/>`,
  },
  {
    x: 185,
    name: "Race horses",
    tag: "Deliver energy",
    bg: "#3f8a86",
    fg: "#f6f1ea",
    icon: `<path d="M60 150 L64 112 Q 60 92 74 78 L84 60 L90 74 Q 108 74 116 92 L128 104 Q 132 112 124 116 L110 112 Q 100 116 98 126 L104 150 Z" fill="#f6f1ea"/>
      <circle cx="104" cy="88" r="3" fill="#12343b"/>
      <path d="M74 80 Q 58 96 56 122" stroke="#12343b" stroke-width="4" fill="none"/>`,
  },
  {
    x: 360,
    name: "Zombies",
    tag: "Absorb energy",
    bg: "#e9dfd2",
    fg: "#12343b",
    icon: `<rect x="56" y="80" width="64" height="40" rx="5" fill="none" stroke="#12343b" stroke-width="5"/>
      <rect x="120" y="92" width="8" height="16" fill="#12343b"/>
      <rect x="62" y="86" width="12" height="28" fill="#a94a22"/>
      <path d="M78 140 L98 140" stroke="#12343b" stroke-width="3"/>`,
  },
  {
    x: 535,
    name: "Vampires",
    tag: "Drain energy",
    bg: "#12343b",
    fg: "#f6f1ea",
    icon: `<path d="M88 92 Q 80 80 70 84 Q 60 76 44 82 Q 54 92 50 106 Q 62 100 70 108 Q 78 100 88 110 Q 98 100 106 108 Q 114 100 126 106 Q 122 92 132 82 Q 116 76 106 84 Q 96 80 88 92 Z" fill="#e07a4f"/>
      <circle cx="84" cy="94" r="2.5" fill="#12343b"/><circle cx="92" cy="94" r="2.5" fill="#12343b"/>`,
  },
];
---

<figure class="art-fig">
  <svg viewBox="0 0 720 260" role="img" aria-labelledby="fe-title fe-desc">
    <title id="fe-title">Four kinds of energy in a team</title>
    <desc id="fe-desc">
      Four tiles: spark plugs create energy, race horses deliver energy, zombies
      absorb energy and vampires drain energy.
    </desc>
    {tiles.map((t) => (
      <g transform={`translate(${t.x} 10)`}>
        <rect width="170" height="240" fill={t.bg} />
        <g set:html={t.icon} transform="translate(0 0)" />
        <text
          x="85"
          y="196"
          text-anchor="middle"
          font-family="Newsreader, Georgia, serif"
          font-size="22"
          font-weight="600"
          fill={t.fg}
        >
          {t.name}
        </text>
        <text
          x="85"
          y="220"
          text-anchor="middle"
          font-family="Inter, sans-serif"
          font-size="11"
          font-weight="700"
          letter-spacing="1.2"
          fill={t.fg}
          opacity="0.8"
        >
          {t.tag.toUpperCase()}
        </text>
      </g>
    ))}
  </svg>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .art-fig {
    margin: 2rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  svg {
    display: block;
    width: 100%;
    height: auto;
    border-bottom: 4px solid var(--color-accent);
  }
  figcaption {
    font-family: var(--font-body);
    font-size: 0.88rem;
    line-height: 1.45;
    color: var(--color-muted);
  }
</style>
