---
// Karpman's drama triangle: persecutor, rescuer and victim, with the way
// out (taking responsibility) shown outside the triangle.
interface Props {
  caption?: string;
}

const { caption } = Astro.props;
---

<figure class="drama">
  <svg viewBox="0 0 720 404" role="img" aria-labelledby="dt-title dt-desc">
    <title id="dt-title">The drama triangle</title>
    <desc id="dt-desc">
      An upside-down triangle with Persecutor at the top left, Rescuer at the
      top right and Victim at the bottom. Arrows run between all three roles. In
      the middle: lose, lose, lose. Outside the triangle, an arrow leads away to
      "Responsibility – the way out".
    </desc>
    <rect width="720" height="404" fill="#f6f1ea"></rect>
    <defs>
      <marker
        id="dt-arrow"
        viewBox="0 0 10 10"
        refX="8"
        refY="5"
        markerWidth="7"
        markerHeight="7"
        orient="auto-start-reverse"
      >
        <path d="M0 0 L10 5 L0 10 Z" fill="#a94a22"></path>
      </marker>
      <marker
        id="dt-arrow-teal"
        viewBox="0 0 10 10"
        refX="8"
        refY="5"
        markerWidth="7"
        markerHeight="7"
        orient="auto"
      >
        <path d="M0 0 L10 5 L0 10 Z" fill="#0f5257"></path>
      </marker>
    </defs>
    <!-- triangle -->
    <path
      d="M110 70 L450 70 L280 350 Z"
      fill="#e9dfd2"
      stroke="#12343b"
      stroke-width="2"
    ></path>
    <!-- cycling arrows -->
    <path
      d="M180 92 L380 92"
      stroke="#a94a22"
      stroke-width="2.5"
      fill="none"
      marker-start="url(#dt-arrow)"
      marker-end="url(#dt-arrow)"
    ></path>
    <path
      d="M405 105 L300 285"
      stroke="#a94a22"
      stroke-width="2.5"
      fill="none"
      marker-start="url(#dt-arrow)"
      marker-end="url(#dt-arrow)"
    ></path>
    <path
      d="M155 105 L260 285"
      stroke="#a94a22"
      stroke-width="2.5"
      fill="none"
      marker-start="url(#dt-arrow)"
      marker-end="url(#dt-arrow)"
    ></path>
    <g font-family="Inter, system-ui, sans-serif" text-anchor="middle">
      <text x="280" y="175" font-size="14" font-weight="700" fill="#12343b">
        LOSE · LOSE · LOSE
      </text>
      <text x="280" y="196" font-size="13" fill="#4a5a60">
        All three roles
      </text>
      <text x="280" y="214" font-size="13" fill="#4a5a60">
        are faces of
      </text>
      <text x="280" y="232" font-size="13" fill="#4a5a60">
        the victim
      </text>
    </g>
    <!-- role badges -->
    <g font-family="Newsreader, Georgia, serif" text-anchor="middle">
      <g>
        <rect x="30" y="14" width="170" height="62" fill="#12343b"></rect>
        <text x="115" y="43" font-size="21" font-weight="600" fill="#f6f1ea">
          Persecutor
        </text>
        <text
          x="115"
          y="64"
          font-family="Inter, system-ui, sans-serif"
          font-size="12"
          fill="#c9dedc"
        >
          “It’s all your fault.”
        </text>
      </g>
      <g>
        <rect x="360" y="14" width="170" height="62" fill="#12343b"></rect>
        <text x="445" y="43" font-size="21" font-weight="600" fill="#f6f1ea">
          Rescuer
        </text>
        <text
          x="445"
          y="64"
          font-family="Inter, system-ui, sans-serif"
          font-size="12"
          fill="#c9dedc"
        >
          “Let me fix it for you.”
        </text>
      </g>
      <g>
        <rect x="195" y="334" width="170" height="62" fill="#12343b"></rect>
        <text x="280" y="363" font-size="21" font-weight="600" fill="#f6f1ea">
          Victim
        </text>
        <text
          x="280"
          y="384"
          font-family="Inter, system-ui, sans-serif"
          font-size="12"
          fill="#c9dedc"
        >
          “Poor me.”
        </text>
      </g>
    </g>
    <!-- the way out -->
    <path
      d="M470 210 L560 210"
      stroke="#0f5257"
      stroke-width="3"
      fill="none"
      marker-end="url(#dt-arrow-teal)"
    ></path>
    <rect x="570" y="160" width="140" height="100" fill="#0f5257"></rect>
    <g font-family="Inter, system-ui, sans-serif" text-anchor="middle">
      <text
        x="640"
        y="190"
        font-size="11"
        font-weight="700"
        letter-spacing="1.5"
        fill="#f2c6a8"
      >
        THE WAY OUT
      </text>
      <text
        x="640"
        y="216"
        font-family="Newsreader, Georgia, serif"
        font-size="19"
        font-weight="600"
        fill="#f6f1ea"
      >
        Taking
      </text>
      <text
        x="640"
        y="240"
        font-family="Newsreader, Georgia, serif"
        font-size="19"
        font-weight="600"
        fill="#f6f1ea"
      >
        responsibility
      </text>
    </g>
  </svg>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .drama {
    margin: 2rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  svg {
    display: block;
    width: 100%;
    height: auto;
    border-bottom: 4px solid var(--color-accent);
  }

  figcaption {
    font-family: var(--font-body);
    font-size: 0.88rem;
    line-height: 1.45;
    color: var(--color-muted);
  }
</style>
