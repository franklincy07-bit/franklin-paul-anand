---
// Two figures side by side, shown large, with a short label under each.
interface Props {
  stats: { value: string; label: string }[];
  source?: string;
}

const { stats, source } = Astro.props;
---

<figure class="stats">
  <div class="row">
    {stats.map((s, i) => (
      <div class:list={["stat", { accent: i === stats.length - 1 }]}>
        <span class="value">{s.value}</span>
        <span class="label">{s.label}</span>
      </div>
    ))}
  </div>
  {source && <figcaption>{source}</figcaption>}
</figure>

<style>
  .stats {
    margin-block: 2rem;
    padding: 1.5rem clamp(1.25rem, 4vw, 2rem);
    background: var(--color-surface);
    border-top: 3px solid var(--color-primary);
    border-bottom: 1px solid var(--color-line);
    font-family: var(--font-body);
  }

  .row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .value {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: clamp(3rem, 8vw, 4.5rem);
    line-height: 0.9;
    letter-spacing: -0.03em;
    color: var(--color-primary);
    font-variant-numeric: tabular-nums;
  }

  .accent .value {
    color: var(--color-accent);
  }

  .label {
    font-size: 0.95rem;
    line-height: 1.45;
    color: var(--color-muted);
    max-width: 24ch;
  }

  figcaption {
    margin-top: 1rem;
    font-size: 0.8rem;
    color: var(--color-muted);
  }

  @media (max-width: 420px) {
    .row {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
