---
// An organisation as an iceberg: programmes and structures above the
// waterline; leadership, culture, values and fears below it.
interface Props {
  caption?: string;
}
const { caption } = Astro.props;
---

<figure class="art-fig">
  <svg viewBox="0 0 720 400" role="img" aria-labelledby="ib-title ib-desc">
    <title id="ib-title">The organisation as an iceberg</title>
    <desc id="ib-desc">
      An iceberg. Above the waterline: programmes, strategy and results; then
      structure, procedures and governance. Below the waterline, much larger:
      leadership and culture – values, symbols, hopes, fears, informal networks
      and biases.
    </desc>
    <rect width="720" height="400" fill="#fbe9e0"></rect>
    <rect y="130" width="720" height="270" fill="#0f5257"></rect>
    <path
      d="M0 130 Q 90 122 180 130 T 360 130 T 540 130 T 720 130"
      stroke="#c9dedc"
      stroke-width="2"
      fill="none"
    ></path>
    <!-- tip -->
    <path d="M300 130 L330 70 L360 40 L392 72 L428 130 Z" fill="#f6f1ea"></path>
    <!-- base -->
    <path
      d="M300 130 L428 130 L520 210 L560 300 L470 380 L300 385 L190 320 L170 230 Z"
      fill="#3f8a86"
      opacity="0.9"
    ></path>
    <g
      font-family="Inter, system-ui, sans-serif"
      font-size="12"
      font-weight="700"
      letter-spacing="1.3"
    >
      <text x="440" y="66" fill="#12343b">
        VISIBLE
      </text>
      <text
        x="440"
        y="84"
        font-weight="400"
        letter-spacing="0"
        font-size="13"
        fill="#4a5a60"
      >
        Programmes, strategy, results
      </text>
      <text
        x="440"
        y="104"
        font-weight="400"
        letter-spacing="0"
        font-size="13"
        fill="#4a5a60"
      >
        Structure, procedures, governance
      </text>
      <text x="40" y="170" fill="#f2c6a8">
        INVISIBLE
      </text>
    </g>
    <g
      font-family="Newsreader, Georgia, serif"
      font-size="19"
      font-weight="600"
      fill="#f6f1ea"
      text-anchor="middle"
    >
      <text x="365" y="215">
        Leadership and culture
      </text>
    </g>
    <g
      font-family="Inter, system-ui, sans-serif"
      font-size="13"
      fill="#f6f1ea"
      text-anchor="middle"
    >
      <text x="365" y="248">
        values · symbols · celebrations
      </text>
      <text x="365" y="272">
        hopes · fears · informal networks
      </text>
      <text x="365" y="296">
        biases · who really decides
      </text>
    </g>
    <text
      x="40"
      y="190"
      font-family="Inter, system-ui, sans-serif"
      font-size="13"
      fill="#c9dedc"
    >
      Where most problems live
    </text>
  </svg>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .art-fig {
    margin: 2rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  svg {
    display: block;
    width: 100%;
    height: auto;
    border-bottom: 4px solid var(--color-accent);
  }
  figcaption {
    font-family: var(--font-body);
    font-size: 0.88rem;
    line-height: 1.45;
    color: var(--color-muted);
  }
</style>
