---
// A numbered journey of stages (e.g. the Youth Hack day), shown as a
// vertical path with a phase name, a short line and what happened.
interface Step {
  phase: string;
  line: string;
  did: string[];
}

interface Props {
  label?: string;
  steps: Step[];
}

const { label, steps } = Astro.props;
---

<section class="steps" aria-label={label ?? "Steps"}>
  {label && <p class="label">{label}</p>}
  <ol>
    {steps.map((s, i) => (
      <li>
        <span class="no" aria-hidden="true">
          {String(i + 1).padStart(2, "0")}
        </span>
        <div class="body">
          <p class="phase">{s.phase}</p>
          <p class="line">{s.line}</p>
          <ul>
            {s.did.map((d) => (
              <li>{d}</li>
            ))}
          </ul>
        </div>
      </li>
    ))}
  </ol>
</section>

<style>
  .steps {
    margin-block: 2.25rem;
    padding: clamp(1.25rem, 4vw, 2rem);
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-top: 4px solid var(--color-teal);
  }

  .label {
    margin: 0 0 1.25rem;
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-teal);
  }

  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
  }

  ol > li {
    position: relative;
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr);
    gap: 1rem;
    padding-bottom: 1.5rem;
  }

  ol > li:last-child {
    padding-bottom: 0;
  }

  /* The path joining one stage to the next. */
  ol > li:not(:last-child)::before {
    content: "";
    position: absolute;
    left: calc(1.375rem - 1px);
    top: 2.75rem;
    bottom: 0;
    width: 2px;
    background: var(--color-line-strong);
  }

  .no {
    width: 2.75rem;
    height: 2.75rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--color-teal);
    color: var(--color-on-dark);
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1rem;
  }

  ol > li:last-child .no {
    background: var(--color-accent);
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding-top: 0.2rem;
  }

  .phase {
    margin: 0;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.3rem;
    line-height: 1.2;
    color: var(--color-primary);
  }

  .line {
    margin: 0;
    font-size: 1rem;
    color: var(--color-body);
  }

  ul {
    margin: 0.35rem 0 0;
    padding-left: 1.1rem;
    display: grid;
    gap: 0.2rem;
    font-size: 0.95rem;
    color: var(--color-muted);
  }
</style>
