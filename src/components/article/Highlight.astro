---
// A key statement set in a highlight box, so it stands out from the text.
// Write it between the tags; wrap the words to emphasise in <em>…</em>.
// tone "dark": deep teal band for the article's big statements.
// tone "light": soft panel with an accent bar, for rules of thumb.
interface Props {
  tone?: "dark" | "light";
  label?: string;
}

const { tone = "dark", label } = Astro.props;
---

<aside class:list={["highlight", tone]}>
  {label && <p class="label">{label}</p>}
  <div class="statement">
    <slot />
  </div>
</aside>

<style>
  .highlight {
    margin-block: 2.25rem;
    padding: clamp(1.5rem, 4vw, 2.25rem) clamp(1.5rem, 4vw, 2.5rem);
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .dark {
    background: var(--color-primary);
    color: var(--color-on-dark);
    box-shadow: inset 6px 0 0 var(--color-accent);
  }

  .light {
    background: var(--color-sand);
    color: var(--color-primary);
    border-left: 6px solid var(--color-accent);
  }

  .label {
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-teal);
  }

  .dark .label {
    color: var(--color-accent);
  }

  .statement {
    margin: 0;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: clamp(1.45rem, 3.2vw, 2rem);
    line-height: 1.22;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .light .statement {
    font-size: clamp(1.25rem, 2.6vw, 1.55rem);
    line-height: 1.35;
  }

  .statement :global(p) {
    margin: 0;
  }

  .statement :global(em) {
    font-style: italic;
    color: var(--color-accent);
  }

  .light .statement :global(em) {
    color: var(--color-teal);
  }
</style>
