---
// Real photos in a grid (2, 3 or 4), each with a short label, a line of
// text and an optional photo credit, plus an optional caption for the whole set.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Item {
  image: ImageMetadata;
  alt: string;
  label: string;
  text?: string;
  credit?: string;
}

interface Props {
  items: Item[];
  caption?: string;
}

const { items, caption } = Astro.props;
---

<figure class:list={["pgrid", `n${items.length}`]}>
  <ul>
    {items.map((it) => (
      <li>
        <Image
          src={it.image}
          alt={it.alt}
          widths={[360, 720]}
          sizes="(max-width: 640px) 100vw, 360px"
        />
        <span class="lab">{it.label}</span>
        {it.text && <span class="txt">{it.text}</span>}
        {it.credit && <span class="cr">{it.credit}</span>}
      </li>
    ))}
  </ul>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .pgrid {
    margin: 2rem 0;
  }

  .pgrid ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .pgrid.n3 ul {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .pgrid ul > li {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    padding-bottom: 0.75rem;
  }

  .pgrid ul > li :global(img) {
    margin: 0 0 0.4rem;
    max-width: none;
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-bottom: 3px solid var(--color-accent);
  }

  .lab,
  .txt,
  .cr {
    padding-inline: 0.85rem;
  }

  .lab {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.2rem;
    line-height: 1.2;
    color: var(--color-primary);
  }

  .txt {
    font-family: var(--font-body);
    font-size: 0.9rem;
    line-height: 1.45;
    color: var(--color-body);
  }

  .cr {
    font-family: var(--font-body);
    font-size: 0.72rem;
    color: var(--color-muted);
  }

  figcaption {
    margin-top: 0.6rem;
    font-family: var(--font-body);
    font-size: 0.88rem;
    line-height: 1.45;
    color: var(--color-muted);
  }

  @media (max-width: 640px) {
    ul,
    .n3 ul {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
