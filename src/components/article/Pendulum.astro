---
// A pendulum swinging between two poles of a polarity, with the downside
// zones at each end and the healthy range in the middle.
interface Props {
  left?: string;
  right?: string;
  caption?: string;
}

const { left = "Scale", right = "Depth", caption } = Astro.props;
const cx = 360;
const cy = 40;
const len = 250;
const pos = (deg: number) => {
  const r = (deg * Math.PI) / 180;
  return { x: cx + len * Math.sin(r), y: cy + len * Math.cos(r) };
};
const l = pos(-48);
const r = pos(48);
const m = pos(-14);
const arc = (a: number, b: number, rad: number) => {
  const s = {
    x: cx + rad * Math.sin((a * Math.PI) / 180),
    y: cy + rad * Math.cos((a * Math.PI) / 180),
  };
  const e = {
    x: cx + rad * Math.sin((b * Math.PI) / 180),
    y: cy + rad * Math.cos((b * Math.PI) / 180),
  };
  return `M ${s.x} ${s.y} A ${rad} ${rad} 0 0 0 ${e.x} ${e.y}`;
};
---

<figure class="pend">
  <svg viewBox="0 0 720 360" role="img" aria-labelledby="pd-title pd-desc">
    <title id="pd-title">Swinging between two sides</title>
    <desc id="pd-desc">
      A pendulum swings between {left} on the left and {right} on the right. The
      far ends are marked as the downside of too much of each. The middle of the
      swing is marked as holding both.
    </desc>
    <rect width="720" height="360" fill="#12343b"></rect>
    <path
      d={arc(-60, -30, len)}
      stroke="#e07a4f"
      stroke-width="16"
      fill="none"
      opacity="0.85"
    ></path>
    <path
      d={arc(30, 60, len)}
      stroke="#e07a4f"
      stroke-width="16"
      fill="none"
      opacity="0.85"
    ></path>
    <path
      d={arc(-30, 30, len)}
      stroke="#3f8a86"
      stroke-width="16"
      fill="none"
    ></path>
    <rect x={cx - 60} y="22" width="120" height="8" fill="#c9dedc"></rect>
    <line
      x1={cx}
      y1={cy}
      x2={l.x}
      y2={l.y}
      stroke="#c9dedc"
      stroke-width="2"
      opacity="0.3"
    ></line>
    <circle cx={l.x} cy={l.y} r="22" fill="#c9dedc" opacity="0.25"></circle>
    <line
      x1={cx}
      y1={cy}
      x2={r.x}
      y2={r.y}
      stroke="#c9dedc"
      stroke-width="2"
      opacity="0.3"
    ></line>
    <circle cx={r.x} cy={r.y} r="22" fill="#c9dedc" opacity="0.25"></circle>
    <line
      x1={cx}
      y1={cy}
      x2={m.x}
      y2={m.y}
      stroke="#f6f1ea"
      stroke-width="3"
    ></line>
    <circle cx={m.x} cy={m.y} r="24" fill="#f6f1ea"></circle>
    <circle cx={cx} cy={cy} r="6" fill="#f6f1ea"></circle>
    <g
      font-family="Newsreader, Georgia, serif"
      font-weight="600"
      fill="#f6f1ea"
      font-size="26"
    >
      <text x="60" y="210">
        {left}
      </text>
      <text x="660" y="210" text-anchor="end">
        {right}
      </text>
    </g>
    <g
      font-family="Inter, system-ui, sans-serif"
      font-size="11"
      font-weight="700"
      letter-spacing="1.4"
    >
      <text x="60" y="232" fill="#f2c6a8">
        TOO MUCH
      </text>
      <text x="660" y="232" text-anchor="end" fill="#f2c6a8">
        TOO MUCH
      </text>
      <text x={cx} y="335" text-anchor="middle" fill="#c9dedc">
        HOLDING BOTH
      </text>
    </g>
  </svg>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .pend {
    margin: 2rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  svg {
    display: block;
    width: 100%;
    height: auto;
    border-bottom: 4px solid var(--color-accent);
  }

  figcaption {
    font-family: var(--font-body);
    font-size: 0.88rem;
    line-height: 1.45;
    color: var(--color-muted);
  }
</style>
