---
// The organisational life cycle (after Ichak Adizes): a rising and falling
// curve from courtship to bureaucracy, with the typical risk at each stage.
interface Props {
  caption?: string;
}

const { caption } = Astro.props;

const stages = [
  {
    x: 80,
    y: 300,
    name: "Courtship",
    risk: "The idea is dropped",
    side: "bottom",
  },
  { x: 160, y: 255, name: "Infancy", risk: "Dies young", side: "end" },
  { x: 250, y: 185, name: "Go-go", risk: "Founder's trap", side: "end" },
  { x: 340, y: 120, name: "Adolescence", risk: "Founder's trap", side: "end" },
  { x: 435, y: 92, name: "Prime", risk: "The healthy peak", side: "top" },
  {
    x: 535,
    y: 125,
    name: "Aristocracy",
    risk: "The fire goes out",
    side: "start",
  },
  {
    x: 590,
    y: 200,
    name: "Bureaucracy",
    risk: "Rules over purpose",
    side: "start",
  },
];

// A smooth curve through every stage (Catmull-Rom converted to Bézier).
const pts = [{ x: 30, y: 325 }, ...stages, { x: 680, y: 320 }];
let path = `M ${pts[0].x} ${pts[0].y}`;
for (let i = 0; i < pts.length - 1; i++) {
  const p0 = pts[i - 1] ?? pts[i];
  const p1 = pts[i];
  const p2 = pts[i + 1];
  const p3 = pts[i + 2] ?? p2;
  const c1x = p1.x + (p2.x - p0.x) / 6;
  const c1y = p1.y + (p2.y - p0.y) / 6;
  const c2x = p2.x - (p3.x - p1.x) / 6;
  const c2y = p2.y - (p3.y - p1.y) / 6;
  path += ` C ${c1x} ${c1y}, ${c2x} ${c2y}, ${p2.x} ${p2.y}`;
}

const lx = (s: (typeof stages)[number]) =>
  s.side === "end" ? s.x - 16 : s.side === "start" ? s.x + 16 : s.x;
const ly = (s: (typeof stages)[number]) =>
  s.side === "top" ? s.y - 34 : s.side === "bottom" ? s.y + 26 : s.y - 4;
---

<figure class="cycle">
  <svg viewBox="0 0 720 380" role="img" aria-labelledby="lc-title lc-desc">
    <title id="lc-title">The organisational life cycle</title>
    <desc id="lc-desc">
      A curve rising from courtship and infancy, through go-go and adolescence,
      to a peak at prime, then falling through aristocracy to bureaucracy. Each
      stage has a typical risk, such as the founder's trap or the fire going
      out.
    </desc>
    <rect width="720" height="380" fill="#f6f1ea"></rect>
    <rect x="385" y="20" width="100" height="320" fill="#e9dfd2"></rect>
    <text
      x="435"
      y="350"
      text-anchor="middle"
      font-family="Inter, sans-serif"
      font-size="11"
      font-weight="700"
      letter-spacing="1.5"
      fill="#0f5257"
    >
      AIM TO STAY HERE
    </text>
    <line
      x1="30"
      y1="340"
      x2="700"
      y2="340"
      stroke="#c9bba9"
      stroke-width="1.5"
    ></line>
    <text
      x="30"
      y="365"
      font-family="Inter, sans-serif"
      font-size="11"
      fill="#4a5a60"
    >
      TIME →
    </text>
    <path
      d={path}
      fill="none"
      stroke="#0f5257"
      stroke-width="5"
      stroke-linecap="round"
    ></path>
    {stages.map((s, i) => (
      <g font-family="Inter, sans-serif">
        <circle
          cx={s.x}
          cy={s.y}
          r="8"
          fill={i === 4 ? "#e07a4f" : "#f6f1ea"}
          stroke="#0f5257"
          stroke-width="3"
        />
        <text
          x={lx(s)}
          y={ly(s)}
          text-anchor={
            s.side === "top" || s.side === "bottom" ? "middle" : s.side
          }
          font-size="14"
          font-weight="700"
          fill="#12343b"
        >
          {s.name}
        </text>
        <text
          x={lx(s)}
          y={ly(s) + 15}
          text-anchor={
            s.side === "top" || s.side === "bottom" ? "middle" : s.side
          }
          font-size="11"
          fill={i === 4 ? "#0f5257" : "#a94a22"}
        >
          {s.risk}
        </text>
      </g>
    ))}
  </svg>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .cycle {
    margin: 2rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  svg {
    display: block;
    width: 100%;
    height: auto;
    border-bottom: 4px solid var(--color-accent);
  }

  figcaption {
    font-family: var(--font-body);
    font-size: 0.88rem;
    line-height: 1.45;
    color: var(--color-muted);
  }
</style>
