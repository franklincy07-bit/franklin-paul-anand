---
// A tightrope walker holding a long balancing pole, each end labelled with
// one side of a polarity: you stay up only by holding both.
interface Props {
  left?: string;
  right?: string;
  caption?: string;
}
const { left = "Scale", right = "Depth", caption } = Astro.props;
---

<figure class="art-fig">
  <svg viewBox="0 0 720 360" role="img" aria-labelledby="tr-title tr-desc">
    <title id="tr-title">Balancing on the tightrope</title>
    <desc id="tr-desc">
      A figure walks a tightrope between two posts, holding a long balancing
      pole. One end of the pole is labelled {left}, the other {right}.
    </desc>
    <rect width="720" height="360" fill="#fbe9e0"></rect>
    <path
      d="M0 360 L0 300 Q 180 270 360 300 T 720 290 L720 360 Z"
      fill="#3f8a86"
      opacity="0.35"
    ></path>
    <rect x="30" y="150" width="14" height="210" fill="#12343b"></rect>
    <rect x="676" y="150" width="14" height="210" fill="#12343b"></rect>
    <path
      d="M44 160 Q 360 215 676 160"
      stroke="#12343b"
      stroke-width="3"
      fill="none"
    ></path>
    <!-- figure -->
    <g fill="#0f5257">
      <circle cx="360" cy="96" r="15"></circle>
      <path d="M346 116 Q 360 110 374 116 L378 160 L342 160 Z"></path>
      <path d="M350 160 L356 186 L352 188 L345 160 Z M370 160 L364 186 L368 188 L375 160 Z"></path>
    </g>
    <path
      d="M350 128 L360 132 L370 128"
      stroke="#0f5257"
      stroke-width="5"
      fill="none"
      stroke-linecap="round"
    ></path>
    <!-- pole -->
    <path
      d="M90 150 Q 360 118 630 150"
      stroke="#a94a22"
      stroke-width="6"
      fill="none"
      stroke-linecap="round"
    ></path>
    <circle cx="90" cy="150" r="10" fill="#e07a4f"></circle>
    <circle cx="630" cy="150" r="10" fill="#e07a4f"></circle>
    <g
      font-family="Newsreader, Georgia, serif"
      font-weight="600"
      font-size="26"
      fill="#12343b"
    >
      <text x="90" y="118" text-anchor="middle">
        {left}
      </text>
      <text x="630" y="118" text-anchor="middle">
        {right}
      </text>
    </g>
    <text
      x="360"
      y="330"
      text-anchor="middle"
      font-family="Inter, sans-serif"
      font-size="12"
      font-weight="700"
      letter-spacing="1.5"
      fill="#12343b"
    >
      LET GO OF EITHER END, AND YOU FALL
    </text>
  </svg>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .art-fig {
    margin: 2rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  svg {
    display: block;
    width: 100%;
    height: auto;
    border-bottom: 4px solid var(--color-accent);
  }
  figcaption {
    font-family: var(--font-body);
    font-size: 0.88rem;
    line-height: 1.45;
    color: var(--color-muted);
  }
</style>
