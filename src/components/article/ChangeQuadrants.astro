---
// Where change happens (after Rao & Kelleher, 2005): individual vs systemic
// on one axis, informal vs formal on the other, with collective action spanning all.
interface Props {
  caption?: string;
}

const { caption } = Astro.props;

const cells = [
  {
    x: 70,
    y: 40,
    title: "Inside people",
    text: ["Attitudes, values,", "practices"],
    fill: "#ffffff",
  },
  {
    x: 380,
    y: 40,
    title: "Access to resources",
    text: ["Who holds land, money,", "skills and services"],
    fill: "#ffffff",
  },
  {
    x: 70,
    y: 200,
    title: "Culture and norms",
    text: ["Beliefs and practices", "in communities"],
    fill: "#e9dfd2",
  },
  {
    x: 380,
    y: 200,
    title: "Public institutions",
    text: ["Programmes, budgets", "and public services"],
    fill: "#e9dfd2",
  },
];
---

<figure class="cq">
  <svg viewBox="0 0 720 400" role="img" aria-labelledby="cq-title cq-desc">
    <title id="cq-title">Where change happens</title>
    <desc id="cq-desc">
      Four boxes. Top row, individual change: inside people (attitudes, values,
      practices) and access to resources. Bottom row, society-wide change:
      culture and norms, and public institutions. Left column informal, right
      column formal. A circle labelled collective action overlaps all four.
    </desc>
    <rect width="720" height="400" fill="#f6f1ea"></rect>
    {cells.map((c) => (
      <g font-family="Inter, system-ui, sans-serif">
        <rect
          x={c.x}
          y={c.y}
          width="290"
          height="140"
          fill={c.fill}
          stroke="#c9bba9"
        />
        <text
          x={c.x + (c.x > 300 ? 60 : 20)}
          y={c.y + 38}
          font-family="Newsreader, Georgia, serif"
          font-size="22"
          font-weight="600"
          fill="#12343b"
        >
          {c.title}
        </text>
        <text
          x={c.x + (c.x > 300 ? 60 : 20)}
          y={c.y + 66}
          font-size="14"
          fill="#4a5a60"
        >
          {c.text[0]}
        </text>
        <text
          x={c.x + (c.x > 300 ? 60 : 20)}
          y={c.y + 86}
          font-size="14"
          fill="#4a5a60"
        >
          {c.text[1]}
        </text>
      </g>
    ))}
    <circle cx="370" cy="190" r="50" fill="#0f5257" opacity="0.92"></circle>
    <g
      text-anchor="middle"
      font-family="Newsreader, Georgia, serif"
      font-size="15"
      font-weight="600"
      fill="#f6f1ea"
    >
      <text x="370" y="180">
        Collective
      </text>
      <text x="370" y="197">
        action
      </text>
    </g>
    <text
      x="370"
      y="213"
      text-anchor="middle"
      font-family="Inter, sans-serif"
      font-size="10"
      fill="#c9dedc"
    >
      reaches all four
    </text>
    <g
      font-family="Inter, sans-serif"
      font-size="11"
      font-weight="700"
      letter-spacing="1.5"
      fill="#a94a22"
    >
      <text x="215" y="370" text-anchor="middle">
        INFORMAL
      </text>
      <text x="525" y="370" text-anchor="middle">
        FORMAL
      </text>
      <text x="40" y="110" text-anchor="middle" transform="rotate(-90 40 110)">
        INDIVIDUAL
      </text>
      <text x="40" y="270" text-anchor="middle" transform="rotate(-90 40 270)">
        SOCIETAL
      </text>
    </g>
  </svg>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .cq {
    margin: 2rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  svg {
    display: block;
    width: 100%;
    height: auto;
    border-bottom: 4px solid var(--color-accent);
  }

  figcaption {
    font-family: var(--font-body);
    font-size: 0.88rem;
    line-height: 1.45;
    color: var(--color-muted);
  }
</style>
