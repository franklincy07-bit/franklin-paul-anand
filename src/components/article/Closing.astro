---
// A closing statement beside a photo with a short caption.
// Write the statement between the tags; wrap the second half in <em>…</em>.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  image: ImageMetadata;
  alt: string;
  captionTitle?: string;
  caption?: string;
  /** "wide": statement above a full-width landscape photo (group shots). */
  layout?: "side" | "wide";
}

const { image, alt, captionTitle, caption, layout = "side" } = Astro.props;
---

<section class:list={["closing", layout]}>
  <div class="statement">
    <slot />
  </div>
  <figure class="photo">
    <div class="frame">
      <Image
        src={image}
        alt={alt}
        widths={[420, 840]}
        sizes={
          layout === "wide"
            ? "(max-width: 760px) 100vw, 720px"
            : "(max-width: 640px) 100vw, 320px"
        }
      />
    </div>
    {(captionTitle || caption) && (
      <figcaption>
        {captionTitle && <span class="ct">{captionTitle}</span>}
        {caption}
      </figcaption>
    )}
  </figure>
</section>

<style>
  .closing {
    margin-block: 2.75rem 2rem;
    padding-block: 2rem;
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 2.5rem);
    align-items: center;
  }

  .statement {
    margin: 0;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: clamp(1.7rem, 3.6vw, 2.3rem);
    line-height: 1.12;
    letter-spacing: -0.015em;
    color: var(--color-primary);
    text-wrap: balance;
  }

  .statement :global(p) {
    margin: 0;
  }

  .statement :global(em) {
    display: block;
    font-style: normal;
    color: var(--color-accent);
  }

  .photo {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .frame {
    position: relative;
    margin-right: 12px;
    margin-bottom: 12px;
  }

  .frame::after {
    content: "";
    position: absolute;
    top: 12px;
    left: 12px;
    right: -12px;
    bottom: -12px;
    background: var(--color-accent);
    z-index: 0;
  }

  .frame :global(img) {
    display: block;
    position: relative;
    z-index: 1;
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
  }

  .wide {
    grid-template-columns: minmax(0, 1fr);
  }

  .wide .frame :global(img) {
    aspect-ratio: auto;
  }

  figcaption {
    font-family: var(--font-body);
    font-size: 0.85rem;
    line-height: 1.45;
    color: var(--color-muted);
  }

  .ct {
    display: block;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin-bottom: 0.15rem;
  }

  @media (max-width: 640px) {
    .closing {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
