---
// Small drawings that sit inside a Sidenote story box: "well" (the truth
// coming out of the well) and "stonecutters" (the three stonecutters).
interface Props {
  story: "well" | "stonecutters";
}

const { story } = Astro.props;

// A wall of blocks for the stonecutters drawing: [x, y, highlighted?]
const wall: [number, number, boolean][] = [];
for (let row = 0; row < 4; row++) {
  const offset = row % 2 ? 18 : 0;
  for (let col = 0; col < 4; col++) {
    const x = 262 + offset + col * 36;
    if (x + 32 > 420) continue;
    wall.push([x, 172 - row * 24, row === 1 && col === 1]);
  }
}
---

<figure class="story-art">
  {story === "well" ? (
    <svg viewBox="0 0 600 270" role="img" aria-labelledby="sa-well">
      <title id="sa-well">
        A stone well with a soft light glowing inside it, while a cloak runs
        away to the right: the Truth stays in the well, and the Lie runs off in
        her clothes.
      </title>
      <line
        x1="40"
        y1="232"
        x2="560"
        y2="232"
        stroke="#c9bba9"
        stroke-width="2"
      />
      {/* roof and posts */}
      <rect x="160" y="62" width="10" height="96" fill="#12343b" />
      <rect x="290" y="62" width="10" height="96" fill="#12343b" />
      <path d="M140 66 L230 26 L320 66 Z" fill="#0f5257" />
      <rect x="168" y="86" width="124" height="6" fill="#12343b" />
      <line
        x1="230"
        y1="92"
        x2="230"
        y2="136"
        stroke="#12343b"
        stroke-width="2"
      />
      <rect x="220" y="134" width="20" height="16" rx="2" fill="#e07a4f" />
      {/* glow from inside the well */}
      <ellipse
        cx="230"
        cy="160"
        rx="62"
        ry="26"
        fill="#e07a4f"
        opacity="0.18"
      />
      {/* body of the well */}
      <path
        d="M150 160 H310 V232 H150 Z"
        fill="#f6f1ea"
        stroke="#12343b"
        stroke-width="3"
      />
      {[176, 194, 212].map((y, r) => (
        <g>
          <line
            x1="150"
            y1={y}
            x2="310"
            y2={y}
            stroke="#c9bba9"
            stroke-width="2"
          />
          {[0, 1, 2, 3].map((i) => (
            <line
              x1={176 + i * 36 + (r % 2 ? 18 : 0)}
              y1={y}
              x2={176 + i * 36 + (r % 2 ? 18 : 0)}
              y2={y + 18}
              stroke="#c9bba9"
              stroke-width="2"
            />
          ))}
        </g>
      ))}
      <ellipse cx="230" cy="160" rx="80" ry="16" fill="#12343b" />
      <ellipse cx="230" cy="162" rx="30" ry="6" fill="#e07a4f" opacity="0.85" />
      {/* the cloak running away */}
      {[0, 1, 2].map((i) => (
        <line
          x1={372 + i * 6}
          y1={150 + i * 18}
          x2={412 + i * 6}
          y2={150 + i * 18}
          stroke="#c9bba9"
          stroke-width="4"
          stroke-linecap="round"
        />
      ))}
      <circle cx="470" cy="112" r="15" fill="#0f5257" />
      <path
        d="M455 128 Q470 120 486 128 L506 210 Q478 220 440 212 L432 200 Q448 170 455 128 Z"
        fill="#0f5257"
      />
      <path
        d="M432 200 Q420 196 410 204"
        stroke="#0f5257"
        stroke-width="8"
        fill="none"
        stroke-linecap="round"
      />
      <line
        x1="462"
        y1="214"
        x2="448"
        y2="232"
        stroke="#12343b"
        stroke-width="5"
        stroke-linecap="round"
      />
      <line
        x1="486"
        y1="214"
        x2="500"
        y2="232"
        stroke="#12343b"
        stroke-width="5"
        stroke-linecap="round"
      />
      <g
        font-family="Newsreader, Georgia, serif"
        font-style="italic"
        font-size="19"
        fill="#12343b"
        text-anchor="middle"
      >
        <text x="230" y="258">
          The Truth, still in the well
        </text>
        <text x="470" y="258">
          The Lie, in the Truth's clothes
        </text>
      </g>
    </svg>
  ) : (
    <svg viewBox="0 0 660 270" role="img" aria-labelledby="sa-stone">
      <title id="sa-stone">
        Three stages of the same work: a rough stone being cut, a squared block
        set into a wall, and the cathedral that the block becomes part of.
      </title>
      <line
        x1="30"
        y1="214"
        x2="630"
        y2="214"
        stroke="#c9bba9"
        stroke-width="2"
      />
      {/* 1. a rough stone and a chisel */}
      <path
        d="M58 214 L64 168 L92 146 L132 152 L156 178 L160 214 Z"
        fill="#e9dfd2"
        stroke="#12343b"
        stroke-width="3"
        stroke-linejoin="round"
      />
      <line
        x1="92"
        y1="146"
        x2="104"
        y2="176"
        stroke="#c9bba9"
        stroke-width="2"
      />
      <line
        x1="132"
        y1="152"
        x2="118"
        y2="186"
        stroke="#c9bba9"
        stroke-width="2"
      />
      <line
        x1="150"
        y1="118"
        x2="126"
        y2="146"
        stroke="#12343b"
        stroke-width="6"
        stroke-linecap="round"
      />
      <rect
        x="146"
        y="96"
        width="30"
        height="16"
        rx="3"
        transform="rotate(-48 161 104)"
        fill="#e07a4f"
      />
      {/* 2. a squared block fitting into a wall */}
      {wall.map(([x, y, hi]) => (
        <rect
          x={x}
          y={y}
          width="32"
          height="20"
          fill={hi ? "#e07a4f" : "#f6f1ea"}
          stroke="#12343b"
          stroke-width="2"
        />
      ))}
      {/* 3. the cathedral */}
      <g fill="#0f5257">
        <rect x="470" y="120" width="140" height="94" />
        <rect x="476" y="70" width="34" height="144" />
        <rect x="570" y="70" width="34" height="144" />
        <path d="M476 70 L493 30 L510 70 Z" />
        <path d="M570 70 L587 30 L604 70 Z" />
        <path d="M510 120 L540 92 L570 120 Z" />
      </g>
      <circle cx="540" cy="140" r="13" fill="#f6f1ea" />
      <circle cx="540" cy="140" r="5" fill="#0f5257" />
      <path d="M528 214 V184 Q540 168 552 184 V214 Z" fill="#12343b" />
      <rect x="584" y="166" width="12" height="9" fill="#e07a4f" />
      {/* arrows */}
      <g stroke="#c9bba9" stroke-width="3" fill="none" stroke-linecap="round">
        <path d="M196 170 H236 M226 160 L236 170 L226 180" />
        <path d="M424 170 H456 M446 160 L456 170 L446 180" />
      </g>
      <g
        font-family="Newsreader, Georgia, serif"
        font-style="italic"
        font-size="19"
        fill="#12343b"
        text-anchor="middle"
      >
        <text x="110" y="244">
          “I am cutting a stone.”
        </text>
        <text x="335" y="244">
          “…so it fits in a wall.”
        </text>
        <text x="540" y="244">
          “I am building
        </text>
        <text x="540" y="264">
          a cathedral.”
        </text>
      </g>
    </svg>
  )}
</figure>

<style>
  .story-art {
    margin: 0.25rem 0 0;
    background: var(--color-bg);
    border: 1px solid var(--color-line);
    padding: 0.75rem 0.75rem 0.5rem;
  }

  .story-art svg {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
