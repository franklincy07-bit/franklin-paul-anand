---
// Ideas as a two-column grid of cards (four makes a 2×2) (e.g. four zones of change, four
// behaviours in a team). Each card has a short tag, a title and a line.
interface Item {
  tag?: string;
  title: string;
  text: string;
}

interface Props {
  label?: string;
  items: Item[];
  note?: string;
}

const { label, items, note } = Astro.props;
---

<figure class="quads">
  {label && <p class="label">{label}</p>}
  <ul>
    {items.map((it, i) => (
      <li class={`q q${items.length === 4 ? i + 1 : (i % 3) + 1}`}>
        {it.tag && <span class="tag">{it.tag}</span>}
        <span class="title">{it.title}</span>
        <span class="text">{it.text}</span>
      </li>
    ))}
  </ul>
  {note && <figcaption>{note}</figcaption>}
</figure>

<style>
  .quads {
    margin: 2.25rem 0;
  }

  .label {
    margin: 0 0 0.85rem;
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-teal);
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .q {
    margin: 0;
    padding: 1.25rem 1.25rem 1.35rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    border-top: 4px solid var(--color-teal);
    background: var(--color-surface);
    border-left: 1px solid var(--color-line);
    border-right: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
  }

  .q2 {
    border-top-color: var(--color-accent);
  }

  .q3 {
    border-top-color: var(--color-primary);
  }

  .q4 {
    background: var(--color-teal);
    border-color: var(--color-teal);
    border-top-color: var(--color-accent);
  }

  .tag {
    font-family: var(--font-body);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .title {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.3rem;
    line-height: 1.2;
    color: var(--color-primary);
  }

  .text {
    font-family: var(--font-body);
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--color-body);
  }

  .q4 .tag,
  .q4 .text {
    color: var(--color-on-dark-muted);
  }

  .q4 .title {
    color: var(--color-on-dark);
  }

  figcaption {
    margin-top: 0.6rem;
    font-family: var(--font-body);
    font-size: 0.85rem;
    color: var(--color-muted);
  }

  @media (max-width: 560px) {
    ul {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
