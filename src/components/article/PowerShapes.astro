---
// Power over, power under, power with – three small scenes of people.
interface Props {
  caption?: string;
}
const { caption } = Astro.props;

// A simple person: head and shoulders, standing on (x, y), scale s.
const person = (x: number, y: number, s: number, fill: string) => `
  <circle cx="${x}" cy="${y - 62 * s}" r="${13 * s}" fill="${fill}"/>
  <path d="M ${x - 20 * s} ${y} L ${x - 20 * s} ${y - 28 * s} Q ${x - 20 * s} ${y - 46 * s} ${x} ${y - 46 * s} Q ${x + 20 * s} ${y - 46 * s} ${x + 20 * s} ${y - 28 * s} L ${x + 20 * s} ${y} Z" fill="${fill}"/>`;

const panels = [
  {
    x: 0,
    title: "Power over",
    line: "Control and authority",
    art:
      `<rect x="70" y="170" width="100" height="60" fill="#c9bba9"/>` +
      person(120, 170, 1.25, "#12343b") +
      person(60, 290, 0.8, "#a94a22") +
      person(180, 290, 0.8, "#a94a22"),
  },
  {
    x: 240,
    title: "Power under",
    line: "Quiet resistance",
    art:
      person(80, 290, 0.85, "#a94a22") +
      person(160, 290, 0.85, "#a94a22") +
      `<path d="M40 150 L200 150" stroke="#12343b" stroke-width="10"/>` +
      `<path d="M80 220 C 70 200, 90 180, 80 158 M160 220 C 170 200, 150 180, 160 158" stroke="#e07a4f" stroke-width="3" fill="none" stroke-dasharray="5 5"/>`,
  },
  {
    x: 480,
    title: "Power with",
    line: "Shared, built on trust",
    art:
      `<circle cx="120" cy="222" r="64" fill="none" stroke="#3f8a86" stroke-width="3" stroke-dasharray="4 6"/>` +
      person(70, 290, 0.95, "#0f5257") +
      person(120, 290, 0.95, "#3f8a86") +
      person(170, 290, 0.95, "#0f5257") +
      `<path d="M88 262 L102 262 M138 262 L152 262" stroke="#0f5257" stroke-width="6" stroke-linecap="round"/>`,
  },
];
---

<figure class="art-fig">
  <svg viewBox="0 0 720 380" role="img" aria-labelledby="pw-title pw-desc">
    <title id="pw-title">Power over, power under, power with</title>
    <desc id="pw-desc">
      Three scenes. Power over: one large figure on a platform above two small
      figures. Power under: two figures beneath a heavy bar, pushing back. Power
      with: three figures side by side, linked, inside a circle.
    </desc>
    <defs>
      <marker
        id="pw-a"
        viewBox="0 0 10 10"
        refX="8"
        refY="5"
        markerWidth="6"
        markerHeight="6"
        orient="auto"
      >
        <path d="M0 0 L10 5 L0 10 Z" fill="#12343b"></path>
      </marker>
    </defs>
    <rect width="720" height="380" fill="#f6f1ea"></rect>
    {panels.map((p, i) => (
      <g transform={`translate(${p.x} 0)`}>
        <rect
          x="8"
          y="14"
          width="224"
          height="352"
          fill={i === 2 ? "#e6efee" : "#ffffff"}
          stroke="#ddd3c6"
        />
        <g set:html={p.art} />
        <line
          x1="30"
          y1="292"
          x2="210"
          y2="292"
          stroke="#c9bba9"
          stroke-width="2"
        />
        <text
          x="120"
          y="326"
          text-anchor="middle"
          font-family="Newsreader, Georgia, serif"
          font-size="22"
          font-weight="600"
          fill="#12343b"
        >
          {p.title}
        </text>
        <text
          x="120"
          y="348"
          text-anchor="middle"
          font-family="Inter, sans-serif"
          font-size="12"
          fill="#4a5a60"
        >
          {p.line}
        </text>
      </g>
    ))}
  </svg>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .art-fig {
    margin: 2rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  svg {
    display: block;
    width: 100%;
    height: auto;
    border-bottom: 4px solid var(--color-accent);
  }
  figcaption {
    font-family: var(--font-body);
    font-size: 0.88rem;
    line-height: 1.45;
    color: var(--color-muted);
  }
</style>
