---
// Privacy-friendly YouTube player. Nothing loads from YouTube until the
// visitor presses play; the video then plays in YouTube's privacy-enhanced
// mode (youtube-nocookie.com). Without JavaScript the button is a plain link.
interface Props {
  youtubeId?: string | null;
  title: string;
}

const { youtubeId, title } = Astro.props;
---

{youtubeId ? (
  <div class="player" data-yt={youtubeId} data-title={title}>
    <a
      class="poster"
      href={`https://www.youtube.com/watch?v=${youtubeId}`}
      data-play
    >
      <span class="play" aria-hidden="true">
        <svg width="30" height="30" viewBox="0 0 24 24" fill="currentColor">
          <polygon points="8 5 19 12 8 19 8 5" />
        </svg>
      </span>
      <span class="cta">Play video</span>
      <span class="note">Plays from YouTube in privacy-enhanced mode</span>
    </a>
  </div>
) : (
  <div class="player soon">
    <span class="cta">This video is coming soon</span>
    <span class="note">The lesson notes below are available now.</span>
  </div>
)}

<script>
  document.querySelectorAll<HTMLElement>("[data-yt]").forEach((el) => {
    el.querySelector("[data-play]")?.addEventListener("click", (event) => {
      event.preventDefault();
      const frame = document.createElement("iframe");
      frame.src = `https://www.youtube-nocookie.com/embed/${el.dataset.yt}?autoplay=1&rel=0`;
      frame.title = el.dataset.title ?? "Video";
      frame.allow =
        "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture";
      frame.allowFullscreen = true;
      frame.referrerPolicy = "strict-origin-when-cross-origin";
      el.replaceChildren(frame);
    });
  });
</script>

<style>
  .player {
    aspect-ratio: 16 / 9;
    background: var(--color-primary);
    color: var(--color-on-dark);
    border-bottom: 4px solid var(--color-accent);
  }

  .player :global(iframe) {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  .poster,
  .soon {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    text-align: center;
    padding: 1.5rem;
    text-decoration: none;
  }

  .poster {
    color: inherit;
  }

  /* No video yet: a shorter panel rather than a large empty frame. */
  .player.soon {
    aspect-ratio: 3 / 1;
    min-height: 11rem;
  }

  .play {
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 50%;
    border: 2px solid currentColor;
    display: grid;
    place-items: center;
    padding-left: 0.25rem;
    margin-bottom: 0.4rem;
  }

  .poster:hover .play,
  .poster:focus-visible .play {
    background: var(--color-accent);
    border-color: var(--color-accent);
  }

  .cta {
    font-family: var(--font-heading);
    font-size: clamp(1.3rem, 3vw, 1.7rem);
  }

  .note {
    font-size: 0.85rem;
    color: var(--color-on-dark-muted);
  }
</style>
