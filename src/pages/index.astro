---
import { link } from "../lib/paths";
import { Image } from "astro:assets";
import candid from "../assets/franklin-candid.jpg";
import Base from "../layouts/Base.astro";
import ArticleListItem from "../components/ArticleListItem.astro";
import headshot from "../assets/franklin-headshot.webp";
import { ARTICLE_TYPES, TOPICS } from "../lib/taxonomy";
import {
  articleUrl,
  formatDate,
  getArticles,
  getProfile,
  getSeries,
  getVideos,
  readingMinutes,
  seriesUrl,
} from "../lib/content";

const profile = await getProfile();
const articles = await getArticles();
const series = await getSeries();
const videos = await getVideos();

// Featured: the newest article marked `featured: true`, otherwise the newest article.
const featured = articles.find((a) => a.data.featured) ?? articles[0];
const more = articles.filter((a) => a !== featured).slice(0, 3);
const lessonCount = (id: string) =>
  videos.filter((v) => v.data.series?.id === id).length;

/**
 * Splits text around the first phrase from `phrases` that it contains, so
 * that phrase can be highlighted. Returns null when none is present, and the
 * text is then shown plainly.
 */
function splitOn(text: string, phrases: string[]) {
  for (const phrase of phrases) {
    const at = text.toLowerCase().indexOf(phrase.toLowerCase());
    if (at >= 0)
      return {
        before: text.slice(0, at),
        match: text.slice(at, at + phrase.length),
        after: text.slice(at + phrase.length),
      };
  }
  return null;
}

// The headline's highlighted words, and the key phrases marked in the intro.
const headline = splitOn(profile.anchorLine, ["young people"]);
const MARKED = ["youth leadership", "Head of Country", "community-level"];
const bio = profile.shortBio.map((para) => ({
  text: para,
  parts: splitOn(para, MARKED),
}));

// Facts for the numbers row, all worked out from profile.yaml.
const firstYear = Math.min(
  ...profile.career
    .map((c) => Number(c.from))
    .filter((y) => Number.isFinite(y)),
);
const years = new Date().getFullYear() - firstYear;
const stats = [
  { value: `${years}+`, label: "years in development and youth leadership" },
  { value: String(profile.expertise.length), label: "areas of expertise" },
  { value: String(profile.languages.length), label: "languages" },
];
---

<Base
  active="home"
  jsonLd={{
    "@type": "Person",
    name: profile.name,
    url: new URL(link("/"), Astro.site).href,
    description: profile.anchorLine,
    sameAs: [profile.links.linkedin, profile.links.youtube].filter(Boolean),
  }}
>
  <!-- Hero: who I am, the headline and a photo -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-text">
        <p class="eyebrow">{profile.descriptor.join(" · ")}</p>
        <h1>
          {headline ? (
            <>
              {headline.before}
              <em>{headline.match}</em>
              {headline.after}
            </>
          ) : (
            profile.anchorLine
          )}
        </h1>
        <p class="lede">{profile.supportingStatement}</p>
        <div class="actions">
          <a class="btn solid" href={link("/about/")}>
            Read my story →
          </a>
          <a class="btn ghost" href={link("/work-with-me/")}>
            Work with me
          </a>
        </div>
      </div>

      <a class="photo-card" href={link("/about/")}>
        <Image
          src={candid}
          alt="Franklin at a youth conference"
          widths={[560, 1100]}
          sizes="(max-width: 900px) 100vw, 560px"
        />
        <span class="tag">About</span>
        <span class="cap">
          <span class="eyebrow">{profile.name}</span>
          <b>From community programmes to organisational leadership</b>
          <span class="go">Read my story →</span>
        </span>
      </a>
    </div>
  </section>

  <!-- Strip: the five areas of expertise -->
  <nav class="areas" aria-label="Areas of expertise">
    <div class="container areas-grid">
      {profile.expertise.map((area, i) => (
        <a href={link(`/writing/topic/${area.topic}/`)}>
          <span class="k">0{i + 1}</span>
          <b>{TOPICS[area.topic]}</b>
          <span class="d">{area.summary}</span>
        </a>
      ))}
    </div>
  </nav>

  <!-- Introduction with key phrases highlighted and a few facts -->
  <section class="container intro" aria-labelledby="intro-title">
    <div class="intro-side">
      <Image
        src={headshot}
        alt={`Portrait of ${profile.name}`}
        widths={[280, 560]}
        sizes="280px"
        class="portrait"
      />
    </div>
    <div class="intro-main">
      <p class="kicker" id="intro-title">
        Hello
      </p>
      {bio.map((p, i) => (
        <p class={i === 0 ? "lead" : "body"}>
          {p.parts ? (
            <>
              {p.parts.before}
              <mark class="hi">{p.parts.match}</mark>
              {p.parts.after}
            </>
          ) : (
            p.text
          )}
        </p>
      ))}
      <dl class="stats">
        {stats.map((s) => (
          <div>
            <dt>{s.label}</dt>
            <dd>{s.value}</dd>
          </div>
        ))}
      </dl>
      <a class="btn dark" href={link("/about/")}>
        Read my story →
      </a>
    </div>
  </section>

  <!-- Writing -->
  <section class="writing" aria-labelledby="writing-title">
    <div class="container">
      <div class="head">
        <div>
          <p class="kicker">Writing</p>
          <h2 id="writing-title">Field notes, insights and how-to guides</h2>
        </div>
        <p>
          Lessons from building organisations and backing young leaders: what
          worked, what didn't, and practical guides you can use.
        </p>
      </div>

      {featured ? (
        <div class="writing-grid">
          <a class="feature" href={articleUrl(featured)}>
            {featured.data.cover && (
              <Image
                src={featured.data.cover}
                alt=""
                widths={[720, 1200]}
                sizes="(max-width: 900px) 100vw, 680px"
                class="feature-cover"
              />
            )}
            <span class="tag">
              {ARTICLE_TYPES[featured.data.type].label}
              {featured.data.draft && (
                <span class="example-badge">Example</span>
              )}
            </span>
            <span class="feature-title">{featured.data.title}</span>
            <span class="feature-meta">
              {formatDate(featured.data.date)} · {readingMinutes(featured.body)}{" "}
              min read
            </span>
            <span class="go">Read →</span>
          </a>
          <div class="list">
            {more.length > 0 ? (
              more.map((a) => <ArticleListItem article={a} />)
            ) : (
              <p class="muted-note">More articles are on their way.</p>
            )}
            <a class="btn dark" href={link("/writing/")}>
              All writing →
            </a>
          </div>
        </div>
      ) : (
        <div class="empty">
          <p class="empty-title">The first articles are being written.</p>
          <p>
            Field notes from programmes, insights on leading organisations, and
            step-by-step guides. In the meantime, read my story.
          </p>
          <a class="btn dark" href={link("/about/")}>
            Read my story →
          </a>
        </div>
      )}
    </div>
  </section>

  <!-- Lessons band -->
  <section class="lessons" aria-labelledby="lessons-title">
    <div class="container lessons-grid">
      <div class="lessons-text">
        <p class="eyebrow">Lessons</p>
        <h2 id="lessons-title">Watch &amp; learn</h2>
        <p class="big">
          Short, practical lessons on leadership, organisations and social
          impact.
        </p>
        {profile.links.youtube ? (
          <a class="btn solid" href={profile.links.youtube} rel="me noopener">
            Subscribe on YouTube
          </a>
        ) : (
          <p class="soon">YouTube channel coming soon</p>
        )}
      </div>

      {series.length > 0 ? (
        <div class="series">
          {series.slice(0, 3).map((s) => (
            <a class="series-card" href={seriesUrl(s)}>
              <span class="play" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="22" height="22">
                  <path d="M7 4.5v15l12-7.5z" fill="currentColor" />
                </svg>
              </span>
              <span class="series-text">
                <span class="k">
                  Series · {lessonCount(s.id)}{" "}
                  {lessonCount(s.id) === 1 ? "lesson" : "lessons"}
                  {s.data.draft && <span class="example-badge">Example</span>}
                </span>
                <b>{s.data.title}</b>
              </span>
            </a>
          ))}
          <a class="all" href={link("/lessons/")}>
            All lessons →
          </a>
        </div>
      ) : (
        <a class="film" href={link("/lessons/")}>
          <span class="play" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="30" height="30">
              <path d="M7 4.5v15l12-7.5z" fill="currentColor" />
            </svg>
          </span>
          <span class="film-cap">
            <span class="k">Coming soon</span>
            <b>Lesson series will appear here once the channel launches</b>
          </span>
        </a>
      )}
    </div>
    <svg
      class="wave"
      viewBox="0 0 1440 80"
      preserveAspectRatio="none"
      aria-hidden="true"
    >
      <path d="M0,52 C240,10 480,10 720,40 C960,70 1200,74 1440,30 L1440,80 L0,80 Z"></path>
    </svg>
  </section>

  <!-- Work with me -->
  <section class="container work" aria-labelledby="work-title">
    <div>
      <p class="kicker">Work with me</p>
      <h2 id="work-title">Ways we can work together</h2>
      <p>{profile.workWithMe.intro}</p>
    </div>
    <div class="work-side">
      <ul>
        {profile.workWithMe.opportunities.map((o) => (
          <li>{o.title}</li>
        ))}
      </ul>
      <a class="btn dark" href={link("/work-with-me/")}>
        Get in touch →
      </a>
    </div>
  </section>
</Base>

<style>
  /* ---------- Shared pieces ---------- */
  .eyebrow {
    font-family: var(--font-label);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .btn {
    display: inline-block;
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 600;
    padding: 0.75rem 1.25rem;
    text-decoration: none;
    border: 2px solid var(--color-accent);
    transition: transform 0.15s ease;
  }

  .btn:hover {
    transform: translateY(-1px);
  }

  .btn.solid {
    background: var(--color-accent);
    color: var(--color-primary);
  }

  .btn.ghost {
    color: var(--color-on-dark);
  }

  .btn.dark {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-on-dark);
    align-self: flex-start;
  }

  .tag {
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
    font-family: var(--font-label);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    background: var(--color-accent);
    color: var(--color-primary);
    padding: 0.35rem 0.6rem;
  }

  .muted-note {
    color: var(--color-muted);
  }

  /* ---------- Hero ---------- */
  .hero {
    background: var(--color-primary);
    color: var(--color-on-dark-muted);
    overflow: hidden;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: center;
    padding-block: clamp(2.5rem, 6vw, 5rem);
  }

  .hero-text {
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
  }

  .hero .eyebrow {
    color: var(--color-on-dark-muted);
  }

  .hero h1 {
    font-size: clamp(2.1rem, 3.7vw, 3.25rem);
    font-weight: 800;
    line-height: 1.04;
    letter-spacing: -0.035em;
    color: var(--color-accent);
  }

  .hero h1 em {
    font-style: normal;
    display: inline-block;
    background: var(--color-accent);
    color: var(--color-primary);
    padding: 0.02em 0.16em 0.06em;
    transform: rotate(-3deg);
    margin-inline: 0.04em;
  }

  .lede {
    font-size: 1.15rem;
    line-height: 1.6;
    max-width: 46ch;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .photo-card {
    position: relative;
    display: block;
    color: var(--color-on-dark);
    text-decoration: none;
    overflow: hidden;
    clip-path: polygon(9% 0, 100% 0, 100% 100%, 0 100%);
    background: var(--color-primary-deep);
  }

  .photo-card :global(img) {
    width: 100%;
    aspect-ratio: 4 / 4.2;
    object-fit: cover;
    object-position: center 30%;
    transition: transform 0.6s ease;
  }

  .photo-card::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      0deg,
      rgba(12, 38, 44, 0.95) 0%,
      rgba(12, 38, 44, 0.55) 38%,
      rgba(12, 38, 44, 0) 66%
    );
  }

  .photo-card:hover :global(img) {
    transform: scale(1.04);
  }

  .photo-card .tag {
    position: absolute;
    z-index: 2;
    top: 1rem;
    right: 1rem;
  }

  .cap {
    position: absolute;
    z-index: 2;
    left: clamp(2.25rem, 5vw, 3.5rem);
    right: 1.25rem;
    bottom: 1.25rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.4rem;
  }

  .cap .eyebrow {
    color: var(--color-accent);
  }

  .cap b {
    font-family: var(--font-heading);
    font-size: clamp(1.2rem, 2.2vw, 1.6rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .go {
    margin-top: 0.4rem;
    padding: 0.45rem 0.8rem;
    background: var(--color-accent);
    color: var(--color-primary);
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 600;
  }

  .photo-card:hover .go {
    background: var(--color-on-dark);
  }

  /* ---------- Areas strip ---------- */
  .areas {
    background: var(--color-primary-deep);
  }

  .areas-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
  }

  .areas a {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    padding: 1.4rem 1.1rem 1.6rem;
    color: var(--color-on-dark);
    text-decoration: none;
    border-right: 1px solid rgba(255, 255, 255, 0.14);
  }

  .areas a:first-child {
    padding-left: 0;
  }

  .areas a:last-child {
    border-right: 0;
  }

  .areas .k {
    font-family: var(--font-label);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    color: var(--color-accent);
  }

  .areas b {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .areas .d {
    font-size: 0.92rem;
    line-height: 1.45;
    color: var(--color-on-dark-muted);
  }

  .areas a:hover b {
    color: var(--color-accent);
  }

  /* ---------- Introduction ---------- */
  .intro {
    display: grid;
    grid-template-columns: minmax(0, 0.38fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
    padding-block: clamp(3.5rem, 7vw, 5.5rem);
  }

  .intro-side :global(.portrait) {
    width: 100%;
    max-width: 17.5rem;
    aspect-ratio: 1;
    object-fit: cover;
    object-position: center 15%;
    clip-path: polygon(0 0, 100% 0, 100% 92%, 0 100%);
  }

  .intro-main {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .lead {
    font-family: var(--font-heading);
    font-size: clamp(1.35rem, 2.4vw, 1.85rem);
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: -0.015em;
    color: var(--color-primary);
    max-width: 34ch;
  }

  .body {
    font-size: 1.12rem;
    color: var(--color-body);
    max-width: 60ch;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
    margin: 0.75rem 0 0.5rem;
    border-top: 1px solid var(--color-line);
    padding-top: 1.25rem;
  }

  .stats div {
    display: flex;
    flex-direction: column-reverse;
    gap: 0.3rem;
  }

  .stats dd {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(2rem, 4vw, 2.8rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--color-teal);
    font-variant-numeric: tabular-nums;
  }

  .stats dt {
    font-size: 0.95rem;
    color: var(--color-muted);
  }

  /* ---------- Writing ---------- */
  .writing {
    background: var(--color-sand);
    padding-block: clamp(3.5rem, 7vw, 5.5rem);
  }

  .head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(1.25rem, 4vw, 4rem);
    align-items: end;
    margin-bottom: clamp(1.75rem, 4vw, 2.75rem);
  }

  .head > div {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .head h2 {
    font-size: clamp(2rem, 4.4vw, 3.2rem);
    line-height: 1.04;
    letter-spacing: -0.03em;
  }

  .head p:not(.kicker) {
    color: var(--color-muted);
    font-size: 1.1rem;
    max-width: 48ch;
  }

  .writing-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: clamp(1.75rem, 4vw, 3rem);
    align-items: start;
  }

  .feature {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-start;
    gap: 0.8rem;
    min-height: 26rem;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    background: var(--color-primary);
    color: var(--color-on-dark);
    text-decoration: none;
    overflow: hidden;
    clip-path: polygon(0 0, 100% 0, 100% 100%, 0 96%);
  }

  .feature-cover {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.35;
  }

  .feature > *:not(.feature-cover) {
    position: relative;
  }

  .feature-title {
    font-family: var(--font-heading);
    font-size: clamp(1.7rem, 3.4vw, 2.5rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.025em;
    color: var(--color-accent);
    max-width: 22ch;
  }

  .feature-meta {
    font-size: 0.95rem;
    color: var(--color-on-dark-muted);
  }

  .feature:hover .go {
    background: var(--color-on-dark);
  }

  .list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  /* On the homepage the list is text only: no cover tiles. */
  .list :global(.item) {
    grid-template-columns: minmax(0, 1fr);
  }

  .list :global(.thumb) {
    display: none;
  }

  .list :global(.item + .item) {
    border-top: 1px solid var(--color-line);
    padding-top: 1.5rem;
  }

  .empty {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    background: var(--color-surface);
    border-left: 6px solid var(--color-accent);
    max-width: 46rem;
  }

  .empty-title {
    font-family: var(--font-heading);
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--color-primary);
  }

  /* ---------- Lessons band ---------- */
  .lessons {
    position: relative;
    background: var(--color-primary);
    color: var(--color-on-dark-muted);
    overflow: hidden;
  }

  .lessons-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
    padding-block: clamp(3.5rem, 7vw, 5rem) clamp(5rem, 9vw, 7.5rem);
  }

  .lessons-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }

  .lessons .eyebrow {
    color: var(--color-accent);
  }

  .lessons h2 {
    font-size: clamp(2.2rem, 4.8vw, 3.4rem);
    letter-spacing: -0.03em;
    color: var(--color-accent);
  }

  .big {
    font-family: var(--font-heading);
    font-size: 1.3rem;
    font-weight: 500;
    line-height: 1.4;
    color: var(--color-on-dark);
    max-width: 30ch;
  }

  .soon {
    font-family: var(--font-label);
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-on-dark);
    border: 1px solid rgba(255, 255, 255, 0.3);
    padding: 0.5rem 0.75rem;
  }

  .play {
    flex: none;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--color-accent);
    color: var(--color-primary);
  }

  .play svg {
    margin-left: 3px;
  }

  .film {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2rem;
    min-height: 17rem;
    padding: clamp(1.5rem, 4vw, 2.25rem);
    background: var(--color-primary-deep);
    color: var(--color-on-dark);
    text-decoration: none;
    clip-path: polygon(6% 0, 100% 0, 100% 100%, 0 100%);
    padding-left: clamp(2.5rem, 6vw, 3.5rem);
  }

  .film .play {
    width: 4.5rem;
    height: 4.5rem;
  }

  .film-cap,
  .series-text {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .film b,
  .series-card b {
    font-family: var(--font-heading);
