---
import { getEntry, render, type CollectionEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import ArticleJournal from "../../components/ArticleJournal.astro";
import ArticleFeature from "../../components/ArticleFeature.astro";
import { ARTICLE_TYPES } from "../../lib/taxonomy";
import { getArticles } from "../../lib/content";

export async function getStaticPaths() {
  const articles = await getArticles();
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article, articles },
  }));
}

interface Props {
  article: CollectionEntry<"articles">;
  articles: CollectionEntry<"articles">[];
}

const { article, articles } = Astro.props;
const { Content, headings } = await render(article);
const video = article.data.video
  ? await getEntry(article.data.video)
  : undefined;
const layout = ARTICLE_TYPES[article.data.type].layout;
const pageUrl = new URL(Astro.url.pathname, Astro.site);

// Field Journal: entries are numbered oldest-first; previous/next follow that order.
const journalEntries = articles
  .filter((a) => a.data.type === "field-notes")
  .reverse();
const position = journalEntries.findIndex((a) => a.id === article.id);

// Feature: up to three related articles sharing a topic, then the newest others.
const others = articles.filter((a) => a.id !== article.id);
const sharesTopic = (a: CollectionEntry<"articles">) =>
  a.data.topics.some((t) => article.data.topics.includes(t));
const related = [
  ...others.filter(sharesTopic),
  ...others.filter((a) => !sharesTopic(a)),
].slice(0, 3);
---

<Base
  title={article.data.title}
  description={article.data.summary}
  active="writing"
>
  {layout === "journal" ? (
    <ArticleJournal
      article={article}
      entryNumber={position + 1}
      Content={Content}
      video={video}
      previous={journalEntries[position - 1]}
      next={journalEntries[position + 1]}
    />
  ) : (
    <ArticleFeature
      article={article}
      headings={headings}
      Content={Content}
      video={video}
      related={related}
      pageUrl={pageUrl}
    />
  )}
</Base>
