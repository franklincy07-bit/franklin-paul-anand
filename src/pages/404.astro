---
import { link } from "../lib/paths";
import Base from "../layouts/Base.astro";
---

<Base title="Page not found" description="This page could not be found.">
  <section class="container page">
    <p class="kicker">Error 404</p>
    <h1>This page could not be found</h1>
    <p class="standfirst">
      It may have moved, or the address may have a typo. These might help:
    </p>
    <ul class="links">
      <li>
        <a href={link("/")}>Home</a>
      </li>
      <li>
        <a href={link("/writing/")}>Writing</a>
      </li>
      <li>
        <a href={link("/videos/")}>Videos</a>
      </li>
      <li>
        <a href={link("/lessons/")}>Lessons</a>
      </li>
      <li>
        <a href={link("/about/")}>About</a>
      </li>
    </ul>
  </section>
</Base>

<style>
  .page {
    padding-block: clamp(3rem, 8vw, 6rem) 1rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  h1 {
    max-width: 40rem;
    font-size: clamp(2.2rem, 5vw, 3.2rem);
    line-height: 1.1;
  }

  .standfirst {
    max-width: 40rem;
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 1.3rem;
    color: var(--color-muted);
  }

  .links {
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .links a {
    display: inline-block;
    border: 1px solid var(--color-line-strong);
    padding: 0.5rem 0.9rem;
    font-weight: 600;
    text-decoration: none;
  }

  .links a:hover {
    border-color: var(--color-teal);
  }
</style>
