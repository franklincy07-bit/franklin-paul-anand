---
import { link } from "../lib/paths";
import "../styles/brand/base.css";
import "../styles/brand/franklin-paul-anand.css";
import "@fontsource/poppins/500.css";
import "@fontsource/poppins/600.css";
import "@fontsource/poppins/700.css";
import "@fontsource/poppins/800.css";
import "@fontsource-variable/source-sans-3/wght.css";
import "@fontsource-variable/source-sans-3/wght-italic.css";
import "@fontsource/ibm-plex-mono/500.css";
import "../styles/global.css";
import Header, { type NavKey } from "../components/Header.astro";
import Footer from "../components/Footer.astro";

import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import { ALLOW_INDEXING, DEFAULT_DESCRIPTION, SITE_NAME } from "../lib/site";

interface Props {
  title?: string;
  description?: string;
  active?: NavKey;
  /** Share image for this page (e.g. an article's cover). */
  image?: ImageMetadata;
  imageAlt?: string;
  /** "article" for Writing pages; everything else is a "website". */
  type?: "website" | "article";
  published?: Date;
  /** Structured data (schema.org) describing this page. */
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description = DEFAULT_DESCRIPTION,
  active,
  image,
  imageAlt,
  type = "website",
  published,
  jsonLd,
} = Astro.props;
const pageTitle = title ? `${title} · ${SITE_NAME}` : SITE_NAME;
const canonical = new URL(Astro.url.pathname, Astro.site);
// The "page not found" page has no address of its own, so it declares none.
const isNotFound = /\/404(\.html)?\/?$/.test(Astro.url.pathname);
const shareImage = image
  ? new URL(
      (await getImage({ src: image, width: 1200, format: "jpeg" })).src,
      Astro.site,
    )
  : new URL(link("/og-default.png"), Astro.site);
const shareAlt = image
  ? (imageAlt ?? "")
  : `${SITE_NAME}: ${DEFAULT_DESCRIPTION}`;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {/* Not launched yet: ALLOW_INDEXING in src/lib/site.ts keeps the site out of search engines. */}
    {!ALLOW_INDEXING && <meta name="robots" content="noindex, nofollow" />}
    {!isNotFound && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href={link("/favicon.svg")} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE_NAME} – Writing`}
      href={new URL(link("/rss.xml"), Astro.site)}
    />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    {!isNotFound && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:alt" content={shareAlt} />
    {published && (
      <meta
        property="article:published_time"
        content={published.toISOString()}
      />
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#12343b" />
    {jsonLd && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify({
          "@context": "https://schema.org",
          ...jsonLd,
        })}
      />
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <Header active={active} />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
